# Kopieer dit bestand naar ".env" en vul in. ".env" wordt nooit gecommit.

# IP en poort waarop de backend luistert (alleen LAN, geen port forwarding naar buiten)
LAN_HOST=0.0.0.0
PORT=4000

# FS25 dedicated server stats-feed (Server Settings > webserver, meestal poort 8080)
FS25_STATS_URL=http://127.0.0.1:8080/feed/dedicated-server-stats.xml?code=JOUW_STATS_CODE

# Publieke iCloud-gedeelde agenda als .ics-link (Agenda-app > gedeelde agenda > "Openbare agenda" aanzetten > link kopiëren)
CALENDAR_ICS_URL=https://p12-caldav.icloud.com/published/2/JOUW_AGENDA_LINK

# Publieke iCloud-gedeelde Herinneringen-lijst als .ics-link (Herinneringen-app > lijst delen > "Openbare lijst" > link kopiëren)
REMINDERS_ICS_URL=https://p12-caldav.icloud.com/published/2/JOUW_HERINNERINGEN_LINK

# Cache-duur per endpoint in seconden
CACHE_TTL_SECONDS=30
