# Kopieer dit bestand naar ".env" en vul in. ".env" wordt nooit gecommit.

# IP en poort waarop de backend luistert (alleen LAN, geen port forwarding naar buiten)
LAN_HOST=0.0.0.0
PORT=4000

# FS25 dedicated server stats-feed (Server Settings > webserver, meestal poort 8080)
FS25_STATS_URL=http://192.168.1.43:8080/feed/dedicated-server-stats.xml?code=JOUW_STATS_CODE

# Publieke iCloud-gedeelde agenda als .ics-link (Agenda-app > gedeelde agenda > "Openbare agenda" aanzetten > link kopiëren)
CALENDAR_ICS_URL=https://p12-caldav.icloud.com/published/2/JOUW_AGENDA_LINK

# Publieke iCloud-gedeelde Herinneringen-lijst als .ics-link (Herinneringen-app > lijst delen > "Openbare lijst" > link kopiëren)
REMINDERS_ICS_URL=https://p12-caldav.icloud.com/published/2/JOUW_HERINNERINGEN_LINK

# NS Reisinformatie API — key aanvragen via https://apiportal.ns.nl (gratis account).
# Zet NOOIT je echte key in een bestand dat je commit.
NS_API_KEY=
# Stationscode voor de vertrekkenstabel, bv. LZ voor Lage Zwaluwe. Klopt de code niet
# (geen/verkeerde vertrekken), zoek de juiste op via https://www.ns.nl of de NS-app.
NS_STATION_CODE=LZ

# Cache-duur (seconden) voor snel-veranderende bronnen (systeemstats, FS25)
CACHE_TTL_SECONDS=3
# Cache-duur (seconden) voor trager veranderende/externe bronnen (agenda, herinneringen, NS, weer)
SLOW_CACHE_TTL_SECONDS=60

# Open-Meteo (gratis, geen API key) — coördinaten voor het weerbericht. Standaard: Lage Zwaluwe.
WEATHER_LAT=51.686
WEATHER_LON=4.685
